# 将此文件复制为 .env，然后填入你的 OpenAI API Key
# Copy this file to .env and fill in your OpenAI API key
#
# 正确格式示例 / Correct format:
# OPENAI_API_KEY=sk-proj-xxxxxxxx
#
# 错误格式 / Wrong formats:
# apiKey:sk-proj-xxxxxxxx   ← 不能用冒号 / no colons
# OPENAI_API_KEY: sk-...    ← 不能有空格 / no spaces around =

OPENAI_API_KEY=sk-your-api-key-here

# Optional: change the backend port (default: 3000)
# PORT=3000
